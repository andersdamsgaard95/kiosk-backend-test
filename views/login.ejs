<!DOCTYPE html>
<html>

<head>
    <style>
        body {
            font-family: sans-serif;
            background: #111;
            color: white;
            margin: 0;
            padding: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
        }

        .box {
            width: 320px;
        }

        h1 {
            font-size: 1.5rem;
            margin-bottom: 20px;
        }

        input {
            display: block;
            width: 100%;
            padding: 14px;
            margin-bottom: 12px;
            font-size: 1rem;
            background: #222;
            color: white;
            border: 1px solid #444;
            border-radius: 6px;
        }

        button {
            width: 100%;
            padding: 14px;
            font-size: 1rem;
            background: #e87d3a;
            color: white;
            border: none;
            border-radius: 6px;
            margin-top: 8px;
        }

        .error {
            color: #d96b6b;
            margin-bottom: 12px;
            font-size: 0.85rem;
        }
    </style>
</head>

<body>
    <div class="box">
        <h1>Admin Login</h1>
        <% if (error) { %>
            <div class="error">
                <%= error %>
            </div>
            <% } %>
                <form method="POST" action="/login">
                    <input type="hidden" name="redirect" value="<%= redirect %>">
                    <input type="text" name="username" placeholder="Username" required>
                    <input type="password" name="password" placeholder="Password" required>
                    <button type="submit">Log in</button>
                </form>
    </div>
</body>

</html>